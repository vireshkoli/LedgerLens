# Copy to .env and fill in. .env is ignored by Git, so real values never reach the repository.

# The SEC requires a declared User-Agent with a name and contact email.
SEC_USER_AGENT=

# Hosted LLM keys. They stay on your Mac and are never stored on the A40 host.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

HF_TOKEN=
